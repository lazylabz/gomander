---
import Layout from '../layouts/Layout.astro';
import Header from '../sections/Header.astro';
import Hero from '../sections/Hero/Hero.astro';
import Checklist from '../sections/Checklist.astro';
import Stations from '../sections/Stations.astro';
import Uplink from '../sections/Uplink.astro';
import Download from '../sections/Download.astro';
import Footer from '../sections/Footer.astro';
---

<Layout
	title="Gomander - Command Your Development Workflow | Open Source GUI Tool"
	description="Stop juggling multiple terminal windows! Launch, monitor, and organize multiple commands simultaneously. Perfect for developers managing microservices, monorepos, and complex development environments. Download free for Windows, macOS, and Linux."
>
	<Header />
	<main>
		<Hero />
		<Checklist />
		<Stations />
		<Uplink />
		<Download />
	</main>
	<Footer />
</Layout>
