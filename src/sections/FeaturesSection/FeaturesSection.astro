---
import Rule from "../../components/Rule.astro";
import { FEATURES } from "../../data/content";
---
<section id="features" class="section">
  <Rule label="$ ls ./features/" />

  <h2 class="section-heading">
    One interface.<br />
    <span class="dim-text">All your commands.</span>
  </h2>

  <div class="grid">
    {FEATURES.map((f, i) => (
      <div class="card">
        <div class="card-meta">
          <span class="card-icon">{f.icon}</span>
          <span class="card-num">0{i + 1}</span>
        </div>
        <div class="card-title">{f.title}</div>
        <div class="card-body">{f.body}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .section {
    padding: 0 24px 40px;
  }

  @media (min-width: 1024px) {
    .section {
      padding: 0 56px 40px;
    }
  }

  .section-heading {
    font-size: 36px;
    letter-spacing: -1px;
    margin: 0 0 56px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--text);
  }

  .dim-text {
    color: var(--dim);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: var(--line);
    border: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    background: var(--bg);
    padding: 28px 24px;
    min-height: 180px;
  }

  .card-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 18px;
  }

  .card-icon {
    color: var(--accent);
    font-size: 18px;
  }

  .card-num {
    color: var(--dim);
    font-size: 10px;
    letter-spacing: 1px;
  }

  .card-title {
    font-size: 15px;
    color: var(--text);
    margin-bottom: 10px;
    font-weight: 500;
  }

  .card-body {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.65;
  }
</style>
