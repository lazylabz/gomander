---
import {
	FOOTER_COMMUNITY,
	FOOTER_LEGAL,
	FOOTER_PRODUCT,
	URLS,
} from "../../data/content";

const base = import.meta.env.BASE_URL;
const mascotSrc = base.endsWith("/")
	? `${base}gomander-land.png`
	: `${base}/gomander-land.png`;
---
<footer class="footer">
  <div class="footer-grid">
    <!-- Brand -->
    <div class="brand-col">
      <div class="brand">
        <span class="brand-cursor">▊</span>
        <span class="brand-name">GOMANDER</span>
      </div>
      <p class="brand-tag">// a humble attempt at making local dev suck a little less.</p>
      <!-- Small mascot -->
      <img
        src={mascotSrc}
        alt=""
        aria-hidden="true"
        class="footer-mascot"
      />
    </div>

    <!-- Product -->
    <div class="link-col">
      <div class="col-header">/ product</div>
      {FOOTER_PRODUCT.map(l => (
        <a href={l.href} class="col-link">{l.label}</a>
      ))}
    </div>

    <!-- Community -->
    <div class="link-col">
      <div class="col-header">/ community</div>
      {FOOTER_COMMUNITY.map(l => (
        <a href={l.href} target="_blank" rel="noopener" class="col-link">{l.label}</a>
      ))}
    </div>

    <!-- Legal -->
    <div class="link-col">
      <div class="col-header">/ legal</div>
      {FOOTER_LEGAL.map(l => (
        <a href={l.href} target="_blank" rel="noopener" class="col-link">{l.label}</a>
      ))}
    </div>
  </div>

  <div class="footer-bottom">
    <span>© 2026 GOMANDER — GPL-3.0 LICENSED</span>
    <span>made with ♥ by developers who got tired</span>
  </div>
</footer>

<style>
  .footer {
    padding: 80px 24px 40px;
    border-top: 1px solid var(--line);
    margin-top: 60px;
    position: relative;
  }

  @media (min-width: 1024px) {
    .footer {
      padding: 80px 56px 40px;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .brand-col {
    grid-column: 1 / -1;
    position: relative;
  }

  @media (min-width: 1024px) {
    .brand-col {
      grid-column: auto;
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .brand-cursor {
    color: var(--accent);
  }

  .brand-name {
    letter-spacing: 2px;
    font-weight: 600;
    font-size: 13px;
  }

  .brand-tag {
    font-size: 11px;
    color: var(--dim);
    line-height: 1.7;
    max-width: 260px;
    margin: 0;
  }

  .footer-mascot {
    width: 60px;
    height: 60px;
    object-fit: contain;
    opacity: 0.4;
    transform: scaleX(-1);
    margin-top: 20px;
  }

  .col-header {
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .col-link {
    display: block;
    font-size: 12px;
    color: var(--dim);
    padding: 4px 0;
    text-decoration: none;
    transition: color 0.15s;
  }

  .col-link:hover {
    color: var(--text);
  }

  .footer-bottom {
    margin-top: 64px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 10px;
    color: var(--dim);
    letter-spacing: 1px;
  }
</style>
