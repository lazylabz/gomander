---
import { STATS, URLS, VERSION } from "../../data/content";

const base = import.meta.env.BASE_URL;
const mascotSrc = base.endsWith("/")
	? `${base}gomander-land.png`
	: `${base}/gomander-land.png`;
---
<section class="hero">
  <div class="hero-content">
    <!-- Terminal prompt eyebrow -->
    <div class="eyebrow">
      <span class="eyebrow-user">user@dev</span><span class="eyebrow-colon">:</span><span class="eyebrow-tilde">~</span><span class="eyebrow-cmd">$ gomander --help</span>
    </div>

    <!-- Main headline -->
    <h1 class="headline">
      Command<br />
      your<span class="accent-underscore">_</span><br />
      <span class="dim-word">development</span><br />
      workflow.
    </h1>

    <!-- Description -->
    <p class="desc">
      // Stop juggling 10+ terminal windows.<br />
      // Gomander is the simple GUI that lets you launch, monitor,<br class="br-hide" />
      // and organize all your commands in one beautiful interface.
    </p>

    <!-- CTAs -->
    <div class="cta-row">
      <a href={URLS.releases} target="_blank" rel="noopener" class="cta-primary">↓ download</a>
      <a href={URLS.repo} target="_blank" rel="noopener" class="cta-secondary">★ star on github</a>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      {STATS.map(s => (
        <div class="stat">
          <div class="stat-value">{s.value}</div>
          <div class="stat-label">// {s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Mascot (desktop only) -->
  <img
    src={mascotSrc}
    alt="Gomander mascot"
    class="mascot"
  />
  <div class="mascot-caption">↑ our friend the commander</div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator">
    <img src={`${base}/scroll-down-svgrepo-com.svg`} alt="Scroll down" class="scroll-icon" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 90px 24px 40px;
    min-height: 85vh;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 90px 56px 40px;
    }
  }

  .eyebrow {
    font-size: 11px;
    margin-bottom: 20px;
    letter-spacing: 1px;
    color: var(--dim);
  }
  .eyebrow-user { color: var(--accent); }
  .eyebrow-colon { color: var(--dim); }
  .eyebrow-tilde { color: var(--purple); }
  .eyebrow-cmd { color: var(--dim); }

  .headline {
    font-size: clamp(42px, 8vw, 78px);
    line-height: 0.95;
    margin: 0;
    font-weight: 500;
    letter-spacing: -2px;
    font-family: var(--font-mono);
    color: var(--text);
  }

  .accent-underscore {
    color: var(--accent);
  }

  .dim-word {
    color: var(--dim);
  }

  .desc {
    font-size: 13px;
    color: var(--dim);
    max-width: 520px;
    margin-top: 32px;
    line-height: 1.75;
    font-family: var(--font-mono);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
    align-items: center;
  }

  .cta-primary {
    background: var(--accent);
    color: var(--accent-ink);
    padding: 12px 20px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .cta-primary:hover {
    opacity: 0.85;
  }

  .cta-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line-strong);
    padding: 12px 20px;
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .cta-secondary:hover {
    border-color: var(--accent);
  }

  .stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 36px;
    margin-top: 56px;
    font-size: 11px;
    color: var(--dim);
  }

  .stat-value {
    color: var(--text);
    font-size: 22px;
    font-weight: 500;
  }

  .stat-label {
    margin-top: 4px;
    letter-spacing: 1px;
  }

  .mascot {
    display: none;
    position: absolute;
    right: 56px;
    top: 120px;
    width: 180px;
    height: 180px;
    object-fit: contain;
    opacity: 0.9;
  }

  @media (min-width: 1024px) {
    .mascot {
      display: block;
    }
  }

  .mascot-caption {
    display: none;
    position: absolute;
    right: 56px;
    top: 310px;
    font-size: 10px;
    color: var(--dim);
    letter-spacing: 1px;
  }

  @media (min-width: 1024px) {
    .mascot-caption {
      display: block;
    }
  }

  .br-hide {
    display: none;
  }

  @media (min-width: 640px) {
    .br-hide {
      display: inline;
    }
  }

  .scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0.4;
    animation: fade-in 1s ease 1.5s both;
  }

  .scroll-icon {
    width: 32px;
    height: 32px;
    filter: invert(1);
    animation: bounce 2s ease-in-out infinite;
  }

  :global(html[data-theme="light"]) .scroll-icon {
    filter: invert(0);
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(6px); }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 0.4; }
  }
</style>
