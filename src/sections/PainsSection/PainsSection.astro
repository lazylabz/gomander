---
import Rule from "../../components/Rule.astro";
import { PAINS } from "../../data/content";
---
<section id="pains" class="section">
  <Rule label="$ cat ./problems.md" />

  <div class="grid">
    {PAINS.map(p => (
      <div class="card">
        <div class="card-key">// {p.k}</div>
        <div class="card-title">{p.t}</div>
        <div class="card-desc">{p.d}</div>
      </div>
    ))}
  </div>

  <div class="closing">
    there has to be a better way&nbsp;&nbsp;<span class="closing-arrow">↓</span>
  </div>
</section>

<style>
  .section {
    padding: 0 24px 40px;
  }

  @media (min-width: 1024px) {
    .section {
      padding: 0 56px 40px;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: var(--line);
    border: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    background: var(--bg);
    padding: 24px 20px;
    min-height: 160px;
  }

  .card-key {
    color: var(--accent);
    font-size: 11px;
    margin-bottom: 24px;
    letter-spacing: 1px;
  }

  .card-title {
    font-size: 15px;
    color: var(--text);
    margin-bottom: 8px;
    font-weight: 500;
  }

  .card-desc {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.55;
  }

  .closing {
    font-size: 12px;
    color: var(--dim);
    margin-top: 24px;
    text-align: center;
  }

  .closing-arrow {
    color: var(--accent);
  }
</style>
