---
import Rule from '../../components/Rule.astro';
---
<section id="preview" class="section">
  <Rule label="$ ./preview" />

  <div class="preview-wrapper">
    <svg class="placeholder" viewBox="0 0 960 540" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
      <!-- Border -->
      <rect x="1" y="1" width="958" height="538" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 4" />
      <!-- Diagonal X lines -->
      <line x1="0" y1="0" x2="960" y2="540" stroke="currentColor" stroke-width="1" opacity="0.3" />
      <line x1="960" y1="0" x2="0" y2="540" stroke="currentColor" stroke-width="1" opacity="0.3" />
      <!-- Label -->
      <text
        x="50%"
        y="50%"
        dominant-baseline="middle"
        text-anchor="middle"
        font-family="JetBrains Mono, ui-monospace, monospace"
        font-size="14"
        letter-spacing="2"
        fill="currentColor"
        opacity="0.5"
      >// images coming soon</text>
    </svg>
  </div>

  <div class="caption">
    <span>FIG 01.</span>
    <span>// one pane, zero tab-hunting.</span>
  </div>
</section>

<style>
  .section {
    padding: 0 24px 20px;
  }

  @media (min-width: 1024px) {
    .section {
      padding: 0 56px 20px;
    }
  }

  .preview-wrapper {
    max-width: 860px;
    margin: 0 auto;
  }

  .placeholder {
    width: 100%;
    height: auto;
    display: block;
    color: var(--dim);
  }

  .caption {
    display: flex;
    gap: 20px;
    font-size: 10px;
    color: var(--dim);
    margin-top: 14px;
    letter-spacing: 1px;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
