---
import Rule from '../../components/Rule.astro';
import { ROADMAP } from '../../data/content';
---
<section id="roadmap" class="section">
  <Rule label="$ git log --future" />

  <div class="grid">
    {ROADMAP.map(r => (
      <div class="card">
        <div class="card-label">{r.s}</div>
        <div class="card-title">{r.t}</div>
        <div class="card-desc">{r.d}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .section {
    padding: 0 24px 40px;
  }

  @media (min-width: 1024px) {
    .section {
      padding: 0 56px 40px;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    border-left: 1px solid var(--line);
    padding-left: 20px;
  }

  .card-label {
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .card-title {
    font-size: 14px;
    color: var(--text);
    margin-bottom: 6px;
  }

  .card-desc {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.55;
  }
</style>
